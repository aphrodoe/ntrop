import { Theme, ControlSize, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { AppState } from "../state.slint";

export component QuizScreen inherits VerticalLayout {
    padding: Theme.spacing-xl;
    padding-top: Theme.spacing-xl * 2;
    spacing: Theme.spacing-md;

    Text {
        text: "Quiz " + (AppState.quiz-step + 1) + " / 3";
        color: Theme.palette-foreground;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-title;
        font-weight: Theme.font-weight-semibold;
        horizontal-alignment: center;
    }
    Text {
        text: "What is word #" + AppState.quiz-position + "?";
        color: Theme.palette-muted;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-body;
        horizontal-alignment: center;
    }
    Rectangle { vertical-stretch: 1; }
    Button { text: "Home"; size: ControlSize.md; full-width: true; variant: ButtonVariant.secondary; clicked => { AppState.back-home(); } }
    for c[i] in AppState.quiz-choices: Button { text: c; size: ControlSize.lg; full-width: true; variant: ButtonVariant.secondary; clicked => { AppState.answer(i); } }
}
