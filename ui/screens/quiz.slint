import { AppState } from "../state.slint";
import { NavBar } from "../kit/nav_bar.slint";
import { Pinstripe } from "../kit/pinstripe.slint";
import { ActionSheet } from "../kit/action_sheet.slint";

export component QuizScreen inherits Pinstripe {
    // Home sits in the nav bar, away from the answers, so a mis-tap can't wipe the run.
    NavBar { y: 40px; width: root.width; title: "Quiz " + (AppState.quiz-step + 1) + " / 3"; back-label: "Home"; back => { AppState.back-home(); } }
    ActionSheet {
        y: 104px; height: root.height - 104px;
        title: "What is word #" + AppState.quiz-position + "?";
        buttons: AppState.quiz-choices;
        chosen(i) => { AppState.answer(i); }
    }
}
