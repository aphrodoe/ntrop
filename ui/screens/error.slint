import { Theme, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { AppState } from "../state.slint";

export component ErrorScreen inherits VerticalLayout {
    padding: Theme.spacing-xl;
    padding-top: Theme.spacing-xl * 3;
    spacing: Theme.spacing-lg;

    Text {
        text: AppState.error-text;
        wrap: word-wrap;
        color: Theme.palette-danger;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-body;
        horizontal-alignment: center;
    }
    Rectangle { vertical-stretch: 1; }
    Button { text: "Home"; size: ControlSize.lg; full-width: true; clicked => { AppState.back-home(); } }
}
