import { Theme } from "@ui/theme.slint";
import { NavBar } from "../kit/nav_bar.slint";
import { AppState, Neon, Ios } from "../state.slint";
import { GameHud } from "../widgets/game_hud.slint";

// These markers describe the completed round only. The next prediction never reaches the UI.
component Door inherits Rectangle {
    in property <int> index;
    property <bool> picked: AppState.last-guess >= 0 && AppState.last-pick == root.index;
    property <bool> guessed: AppState.last-guess >= 0 && AppState.last-guess == root.index;
    border-radius: 14px;
    background: #11101B;
    border-width: root.picked ? 3px : 1px;
    border-color: root.picked ? #F2F0FF : Neon.line;

    // A frame, two inset panels, and a handle stay legible at thumb size.
    Rectangle {
        x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 50px;
        border-radius: 7px;
        background: ta.pressed ? #6741C3 : #37265A;
        border-width: 1px; border-color: #8B5CFF80;
        Rectangle { x: 10px; y: 10px; width: parent.width - 20px; height: parent.height * 0.44; border-radius: 3px; background: #20182F; border-width: 1px; border-color: #6B4C9C; }
        Rectangle { x: 10px; y: parent.height * 0.56; width: parent.width - 20px; height: parent.height * 0.44 - 10px; border-radius: 3px; background: #20182F; border-width: 1px; border-color: #6B4C9C; }
        Text {
            y: 14px; width: parent.width; height: parent.height * 0.42;
            text: root.index + 1; color: #F2F0FF;
            font-family: Ios.font; font-size: 38px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
        }
        Rectangle { x: parent.width - 24px; y: parent.height * 0.55; width: 9px; height: 9px; border-radius: 4.5px; background: #D7C7FF; }
    }
    Text {
        y: parent.height - 36px; width: parent.width; height: 26px;
        text: root.picked && root.guessed ? "YOU + MACHINE" : root.picked ? "YOUR PICK" : root.guessed ? "MACHINE" : "DOOR " + (root.index + 1);
        color: root.picked ? #FFFFFF : root.guessed ? #C6ADFF : Theme.palette-muted;
        font-family: Ios.font; font-size: 13px; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.guessed: Rectangle { x: parent.width / 2 - 21px; y: parent.height - 7px; width: 42px; height: 3px; border-radius: 1.5px; background: Neon.game; }
    ta := TouchArea {
        // One pick per press; no release delay can swallow the next quick choice.
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                AppState.pick-door(root.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

export component OutguessScreen inherits Rectangle {
    background: Theme.palette-background;
    property <bool> picked: AppState.last-guess >= 0;
    property <bool> learning: AppState.outguess-round <= 16;

    GameHud {
        y: 104px; width: root.width;
        healthy: AppState.game-healthy;
        hint: AppState.outguess-round == 0 ? "Pick a door. The machine guesses in secret."
            : root.learning ? "Learning your pattern: " + AppState.outguess-round + " / 16 choices"
            : AppState.game-healthy ? "Each pick is a new round. Keep playing."
            : "Pattern detected. Credits follow unpredictability.";
    }
    Text {
        x: 20px; y: 208px; width: root.width - 40px; height: 30px;
        text: "Choose your door"; color: Theme.palette-foreground;
        font-family: Ios.font; font-size: 25px; font-weight: 700;
        horizontal-alignment: center;
    }
    Text {
        x: 20px; y: 246px; width: root.width - 40px; height: 22px;
        text: "Your pick and its last guess stay marked.";
        color: Theme.palette-muted; font-family: Ios.font; font-size: 15px;
        horizontal-alignment: center;
    }
    GridLayout {
        x: 20px; y: 280px; width: root.width - 40px; height: 396px;
        spacing: 16px;
        Row { Door { index: 0; } Door { index: 1; } }
        Row { Door { index: 2; } Door { index: 3; } }
    }
    Rectangle {
        x: 20px; y: 690px; width: root.width - 40px; height: 92px;
        background: Neon.raised; border-radius: 12px;
        Rectangle { x: 0; y: 12px; width: 3px; height: parent.height - 24px; border-radius: 1.5px; background: !root.picked ? Neon.game : AppState.last-hit ? Theme.palette-danger : Theme.palette-primary; }
        Text {
            x: 12px; y: 10px; width: parent.width - 24px; height: 24px;
            text: !root.picked ? "BEAT ITS GUESS" : AppState.last-hit ? "THE MACHINE FOUND YOU" : "YOU OUTGUESSED IT";
            color: !root.picked ? Theme.palette-foreground : AppState.last-hit ? Theme.palette-danger : Theme.palette-primary;
            font-family: Ios.font; font-size: 17px; font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            x: 12px; y: 38px; width: parent.width - 24px; height: 20px;
            text: !root.picked ? "A win and entropy credit are different."
                : "Machine chose door " + (AppState.last-guess + 1) + "  ·  " + AppState.last-credit;
            color: Theme.palette-foreground; font-family: Ios.font; font-size: 15px;
            horizontal-alignment: center;
        }
        Text {
            x: 12px; y: 64px; width: parent.width - 24px; height: 18px;
            text: root.picked ? "The machine reads you " + AppState.read-pct + "%" : "The first 16 choices are the learning period.";
            color: Theme.palette-muted; font-family: Ios.font; font-size: 13px;
            horizontal-alignment: center;
        }
    }
    NavBar {
        y: 40px; width: root.width; title: "Outguess"; back-label: "Home"; right-label: "Done";
        right-enabled: AppState.touch-bits + AppState.camera-bits + AppState.game-bits >= AppState.target-bits;
        back => { AppState.back-home(); }
        right => { AppState.painter-done(); }
    }
}
