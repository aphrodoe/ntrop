import { Theme, ControlSize, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { AppState, Neon } from "../state.slint";
import { Meter } from "../widgets/meter.slint";

export component HuntScreen inherits Rectangle {
    background: Theme.palette-background;

    VerticalLayout {
        padding: Theme.spacing-xl;
        padding-top: Theme.spacing-xl * 2;
        spacing: Theme.spacing-md;
        Meter { vertical-stretch: 0; }
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.spacing-md;
            Button {
                text: "Home";
                variant: ButtonVariant.ghost;
                clicked => { AppState.back-home(); }
            }
            Button {
                text: "Done";
                disabled: AppState.touch-bits + AppState.camera-bits + AppState.game-bits < AppState.target-bits;
                clicked => { AppState.painter-done(); }
            }
        }
        Text {
            text: AppState.game-healthy ? "Drag to look. Tap the ghosts." : "Shots too samey: vary your aim";
            color: AppState.game-healthy ? Theme.palette-muted : Theme.palette-danger;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-label;
            horizontal-alignment: center;
            vertical-stretch: 0;
        }
        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                x: (parent.width - 480px) / 2;
                y: 0px;
                width: 480px;
                height: 640px;
                Image {
                    width: 100%;
                    height: 100%;
                    source: AppState.hunt-frame;
                    image-rendering: pixelated;
                    image-fit: fill;
                }
                Rectangle { x: 240px - 10px; y: 320px - 1px; width: 20px; height: 2px; background: Neon.touch; }
                Rectangle { x: 240px - 1px; y: 320px - 10px; width: 2px; height: 20px; background: Neon.touch; }
                if AppState.hunt-pop != "": Text {
                    y: 120px;
                    width: 100%;
                    text: AppState.hunt-pop;
                    color: Neon.game;
                    font-family: Theme.font-primary;
                    font-size: 48px;
                    horizontal-alignment: center;
                }
                TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down { AppState.hunt-press(self.mouse-x, self.mouse-y); }
                        if e.kind == PointerEventKind.up { AppState.hunt-release(self.mouse-x, self.mouse-y); }
                    }
                    moved => { AppState.hunt-move(self.mouse-x, self.mouse-y); }
                }
            }
        }
    }
}
