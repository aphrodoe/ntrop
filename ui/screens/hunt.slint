import { NavBar } from "../kit/nav_bar.slint";
import { AppState, Ios, Neon } from "../state.slint";
import { GameHud } from "../widgets/game_hud.slint";

export component HuntScreen inherits Rectangle {
    background: #0B0A12;

    GameHud {
        y: 104px;
        width: root.width;
        healthy: AppState.game-healthy && AppState.touch-healthy;
        hint: !AppState.game-healthy ? "Repeated shots earn no bits. Vary your aim."
            : !AppState.touch-healthy ? "Look movement repeated. Change direction."
            : AppState.hunt-note != "" ? AppState.hunt-note
            : "Drag to look. Tap a ghost to blast.";
    }

    // The renderer is 240x288 and input remains exactly 2x, without cropped edges.
    Rectangle {
        x: (root.width - 480px) / 2;
        y: 196px;
        width: 480px;
        height: 576px;
        clip: true;
        Image {
            width: 480px;
            height: 576px;
            source: AppState.hunt-frame;
            image-rendering: pixelated;
            image-fit: fill;
        }

        // Four separate strokes leave the target visible in the middle.
        Rectangle {
            x: 218px; y: 286px; width: 16px; height: 4px; background: #0B0A12;
            Rectangle { x: 1px; y: 1px; width: 14px; height: 2px; background: Neon.game; }
        }
        Rectangle {
            x: 246px; y: 286px; width: 16px; height: 4px; background: #0B0A12;
            Rectangle { x: 1px; y: 1px; width: 14px; height: 2px; background: Neon.game; }
        }
        Rectangle {
            x: 238px; y: 266px; width: 4px; height: 16px; background: #0B0A12;
            Rectangle { x: 1px; y: 1px; width: 2px; height: 14px; background: Neon.game; }
        }
        Rectangle {
            x: 238px; y: 294px; width: 4px; height: 16px; background: #0B0A12;
            Rectangle { x: 1px; y: 1px; width: 2px; height: 14px; background: Neon.game; }
        }

        // Only the controller's actual credited-shot message produces this pop.
        if AppState.hunt-pop != "": Rectangle {
            x: 166px;
            y: 96px;
            width: 148px;
            height: 48px;
            border-radius: 12px;
            border-width: 1px;
            border-color: Neon.game;
            background: #100F1B;
            Text {
                text: AppState.hunt-pop;
                color: Neon.game;
                font-family: Ios.font;
                font-size: 30px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down { AppState.hunt-press(self.mouse-x, self.mouse-y); }
                if e.kind == PointerEventKind.up { AppState.hunt-release(self.mouse-x, self.mouse-y); }
            }
            moved => {
                if self.pressed { AppState.hunt-move(self.mouse-x, self.mouse-y); }
            }
        }
    }
    Rectangle {
        y: 772px;
        width: root.width;
        height: 28px;
        background: #100F1B;
        Rectangle { height: 1px; background: Neon.line; }
        Text {
            text: "Drag to look  ·  Tap a ghost to blast";
            color: #C3BFE0;
            font-family: Ios.font;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    NavBar {
        y: 40px;
        width: root.width;
        title: "Static Hunt";
        back-label: "Home";
        right-label: "Done";
        right-enabled: AppState.touch-bits + AppState.camera-bits + AppState.game-bits >= AppState.target-bits;
        back => { AppState.back-home(); }
        right => { AppState.painter-done(); }
    }
}
