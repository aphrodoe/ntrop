import { Theme } from "@ui/theme.slint";
import { NavBar } from "../kit/nav_bar.slint";
import { AppState, Neon } from "../state.slint";
import { Meter } from "../widgets/meter.slint";

export component HuntScreen inherits Rectangle {
    background: Theme.palette-background;

    VerticalLayout {
        padding: Theme.spacing-xl;
        padding-top: 116px;
        spacing: Theme.spacing-md;
        Meter { vertical-stretch: 0; }
        Text {
            text: AppState.game-healthy ? "Drag to look. Tap the ghosts." : "Shots too samey: vary your aim";
            color: AppState.game-healthy ? Theme.palette-muted : Theme.palette-danger;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-label;
            horizontal-alignment: center;
            vertical-stretch: 0;
        }
        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                x: (parent.width - 480px) / 2;
                y: 0px;
                width: 480px;
                height: 576px;
                Image {
                    width: 100%;
                    height: 100%;
                    source: AppState.hunt-frame;
                    image-rendering: pixelated;
                    image-fit: fill;
                }
                Rectangle { x: 240px - 10px; y: 288px - 1px; width: 20px; height: 2px; background: Neon.game; }
                Rectangle { x: 240px - 1px; y: 288px - 10px; width: 2px; height: 20px; background: Neon.game; }
                if AppState.hunt-pop != "": Text {
                    y: 120px;
                    width: 100%;
                    text: AppState.hunt-pop;
                    color: Neon.game;
                    font-family: Theme.font-primary;
                    font-size: 48px;
                    horizontal-alignment: center;
                }
                TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down { AppState.hunt-press(self.mouse-x, self.mouse-y); }
                        if e.kind == PointerEventKind.up { AppState.hunt-release(self.mouse-x, self.mouse-y); }
                    }
                    moved => { AppState.hunt-move(self.mouse-x, self.mouse-y); }
                }
            }
        }
    }
    NavBar {
        y: 40px; width: root.width; title: "Static Hunt"; back-label: "Home"; right-label: "Done";
        right-enabled: AppState.touch-bits + AppState.camera-bits + AppState.game-bits >= AppState.target-bits;
        back => { AppState.back-home(); }
        right => { AppState.painter-done(); }
    }
}
