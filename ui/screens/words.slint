import { AppState } from "../state.slint";
import { NavBar } from "../kit/nav_bar.slint";
import { Pinstripe } from "../kit/pinstripe.slint";
import { GroupedCell, GroupLabel } from "../kit/grouped_cell.slint";
import { GlossyButton } from "../kit/glossy_button.slint";

export component WordsScreen inherits Pinstripe {
    NavBar { y: 40px; width: root.width; title: "Your seed words"; back-label: "Home"; back => { AppState.back-home(); } }
    VerticalLayout {
        y: 104px; height: root.height - 104px;
        padding: 18px; padding-bottom: 28px;
        spacing: 0;
        GroupLabel { text: "Write these down. Never photograph them."; tone: #A3171D; }
        Rectangle { height: 10px; }
        for w[i] in AppState.page-words: GroupedCell {
            first: i == 0; last: i == AppState.page-words.length - 1;
            label: (AppState.first-index + i) + ". " + w;
        }
        Rectangle { height: 10px; }
        GroupLabel { text: (AppState.page + 1) + " / " + AppState.page-count; align: center; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 12px;
            if AppState.page > 0: GlossyButton { text: "Back"; clicked => { AppState.prev-page(); } }
            GlossyButton { primary: true; text: AppState.page + 1 < AppState.page-count ? "Next" : "Show SeedQR"; clicked => { AppState.next-page(); } }
        }
    }
}
