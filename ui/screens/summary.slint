import { AppState } from "../state.slint";
import { NavBar } from "../kit/nav_bar.slint";
import { Pinstripe } from "../kit/pinstripe.slint";
import { GroupedCell, GroupLabel } from "../kit/grouped_cell.slint";
import { SlideConfirm } from "../kit/slide_confirm.slint";

export component SummaryScreen inherits Pinstripe {
    NavBar { y: 40px; width: root.width; title: "Entropy collected"; back-label: "Home"; back => { AppState.back-home(); } }
    VerticalLayout {
        y: 104px; height: root.height - 104px;
        padding: 18px; padding-top: 22px; padding-bottom: 28px;
        spacing: 0;
        // Deliberate: rows for sources that credited nothing this run are hidden (Touch always shows).
        GroupedCell { first: true; last: AppState.camera-bits == 0 && AppState.game-bits == 0; label: "Touch"; detail: AppState.touch-bits + " bits (conservative estimate)"; }
        if AppState.camera-bits > 0: GroupedCell { last: AppState.game-bits == 0; label: "Camera"; detail: AppState.camera-bits + " bits (conservative estimate)"; }
        if AppState.game-bits > 0: GroupedCell { last: true; label: "Game skill"; detail: AppState.game-bits + " bits (conservative estimate)"; }
        Rectangle { height: 22px; }
        GroupedCell { first: true; last: true; label: "+ hardware 256"; }
        GroupLabel { text: "Mixed in from the device TRNG"; size: 15px; weight: 400; align: center; }
        Rectangle { vertical-stretch: 1; }
        SlideConfirm { text: "slide to generate"; confirmed => { AppState.generate(); } }
    }
}
