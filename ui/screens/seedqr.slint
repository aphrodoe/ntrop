import { AppState, Ios } from "../state.slint";
import { NavBar } from "../kit/nav_bar.slint";
import { Pinstripe } from "../kit/pinstripe.slint";
import { GroupLabel } from "../kit/grouped_cell.slint";
import { GlossyButton } from "../kit/glossy_button.slint";

export component SeedQrScreen inherits Pinstripe {
    NavBar { y: 40px; width: root.width; title: "SeedQR"; back-label: "Home"; back => { AppState.back-home(); } }
    VerticalLayout {
        y: 104px; height: root.height - 104px;
        padding: 18px; padding-bottom: 28px;
        spacing: 10px;
        GroupLabel { text: "Scan with an offline wallet. Never photograph it."; tone: #A3171D; align: center; }
        Rectangle {
            height: 424px;
            border-radius: 10px;
            background: Ios.separator;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                border-radius: 9px;
                background: #FFFFFF;
                Image { y: 12px; height: 400px; width: parent.width; source: AppState.qr; image-fit: contain; image-rendering: pixelated; }
            }
        }
        Rectangle { vertical-stretch: 1; }
        GlossyButton { primary: true; text: "Quiz me"; clicked => { AppState.start-quiz(); } }
    }
}
