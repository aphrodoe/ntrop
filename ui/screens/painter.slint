import { Theme } from "@ui/theme.slint";
import { NavBar } from "../kit/nav_bar.slint";
import { GlossyButton } from "../kit/glossy_button.slint";
import { AppState, Neon } from "../state.slint";
import { Toast, ToastVariant } from "@ui/toast.slint";
import { Meter } from "../widgets/meter.slint";

export component PainterScreen inherits Rectangle {
    background: Theme.palette-background;

    TouchArea {
        moved => { AppState.touch(self.mouse-x, self.mouse-y); }
    }
    for d in AppState.trail: Rectangle {
        x: d.x - 12px;
        y: d.y - 12px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: Neon.touch.with-alpha(0.12);
        opacity: 1 - d.age;
    }
    for d in AppState.trail: Rectangle {
        x: d.x - 9px;
        y: d.y - 9px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Neon.touch.with-alpha(0.25);
        opacity: 1 - d.age;
    }
    for d in AppState.trail: Rectangle {
        x: d.x - 6px;
        y: d.y - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Neon.touch;
        opacity: 1 - d.age;
    }
    Text {
        y: parent.height / 2;
        width: parent.width;
        text: "Scribble anywhere";
        color: Theme.palette-muted.with-alpha(0.5);
        font-family: Theme.font-primary;
        font-size: Theme.font-size-body;
        horizontal-alignment: center;
    }
    VerticalLayout {
        y: 116px;
        height: 90px;
        x: Theme.spacing-xl;
        width: parent.width - Theme.spacing-xl * 2;
        Meter { }
    }
    if AppState.camera-on: Image {
        x: parent.width - Theme.spacing-xl - 96px;
        y: 206px;
        width: 96px;
        height: 96px;
        source: AppState.camera-preview;
        image-rendering: pixelated;
    }
    if AppState.camera-note != "": Text {
        x: parent.width / 2;
        y: 206px;
        text: AppState.camera-note;
        color: Theme.palette-danger;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-body;
    }
    if !AppState.touch-healthy: Toast {
        y: parent.height - 64px - Theme.spacing-xl * 2 - 120px;
        width: parent.width;
        height: 120px;
        variant: ToastVariant.error;
        message: "Touch rejected: keep moving";
    }
    GlossyButton {
        x: Theme.spacing-xl;
        y: parent.height - self.height - Theme.spacing-xl;
        width: parent.width - Theme.spacing-xl * 2;
        text: AppState.camera-on ? "Camera: on" : "Camera: off";
        clicked => { AppState.toggle-camera(); }
    }
    NavBar {
        y: 40px; width: root.width; title: "Chaos Painter"; back-label: "Home"; right-label: "Done";
        right-enabled: AppState.touch-bits + AppState.camera-bits + AppState.game-bits >= AppState.target-bits;
        back => { AppState.back-home(); }
        right => { AppState.painter-done(); }
    }
}
