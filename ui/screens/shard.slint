import { Theme } from "@ui/theme.slint";
import { NavBar } from "../kit/nav_bar.slint";
import { AppState, Ios, Neon } from "../state.slint";
import { GameHud } from "../widgets/game_hud.slint";

// Immediate game actions: one press, one move. Holding never repeats a placement.
component ShardControl inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback activated();
    height: 64px;
    Image {
        width: parent.width; height: parent.height;
        source: root.primary || ta.pressed ? @image-url("../../resources/icons/sheet-button-on.svg", nine-slice(12)) : @image-url("../../resources/icons/key.svg", nine-slice(12));
    }
    Text { text: root.text; color: #FFFFFF; font-family: Ios.font; font-size: 18px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    if ta.pressed: Rectangle { background: #00000026; border-radius: 10px; }
    ta := TouchArea {
        pointer-event(e) => { if e.kind == PointerEventKind.down { root.activated(); } }
    }
}

export component ShardScreen inherits Rectangle {
    background: Theme.palette-background;
    property <length> cell: 30px;
    property <int> applied: 0;
    property <int> applied-y: 0;
    // 0 = unclassified tap, 1 = sideways, 2 = vertical; never change axes mid-swipe.
    property <int> axis: 0;

    GameHud {
        y: 104px; width: root.width;
        healthy: AppState.game-healthy;
        hint: AppState.shard-note != "" ? AppState.shard-note : "Swipe down: soft drop. Drop: hard drop.";
    }

    // All 8x16 cells stay visible; the selected landing is geometry, never a recommended move.
    board := Rectangle {
        x: (root.width - 8 * root.cell) / 2; y: 200px;
        width: 8 * root.cell; height: 16 * root.cell;
        background: #111725; border-width: 1px; border-color: #46516A; clip: true;
        for column in 7: Rectangle { x: (column + 1) * root.cell; width: 1px; height: parent.height; background: #30384A; }
        for row in 15: Rectangle { y: (row + 1) * root.cell; height: 1px; width: parent.width; background: #30384A; }

        for v[i] in AppState.shard-cells: Rectangle {
            visible: v == 1;
            x: mod(i, 8) * root.cell + 1px; y: floor(i / 8) * root.cell + 1px;
            width: root.cell - 2px; height: root.cell - 2px; border-radius: 3px;
            background: #7050BB; border-width: 1px; border-color: #AE91ED;
            Rectangle { x: 3px; y: 3px; width: parent.width - 6px; height: 3px; background: #FFFFFF3B; }
            Rectangle { x: 3px; y: parent.height - 5px; width: parent.width - 6px; height: 2px; background: #00000040; }
        }
        for landing[i] in AppState.landing-cells: Rectangle {
            visible: landing == 1;
            x: mod(i, 8) * root.cell + 2px; y: floor(i / 8) * root.cell + 2px;
            width: root.cell - 4px; height: root.cell - 4px; border-radius: 3px;
            background: Neon.game.with-alpha(0.12); border-width: 2px; border-color: #BB9CFF;
        }
        for g[i] in AppState.ghost-cells: Rectangle {
            visible: g == 1;
            x: mod(i, 8) * root.cell + 1px; y: floor(i / 8) * root.cell + 1px;
            width: root.cell - 2px; height: root.cell - 2px; border-radius: 3px;
            background: #C8AEFF; border-width: 2px; border-color: #F1E8FF;
            Rectangle { x: 5px; y: 5px; width: parent.width - 10px; height: 3px; background: #FFFFFF80; }
        }
    }

    VerticalLayout {
        x: 14px; y: 214px; width: 96px; height: 330px; spacing: 3px;
        Text { text: "LINES"; color: #9DA9C1; font-family: Ios.font; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
        Text { text: AppState.shard-lines; color: #E9DDFF; font-family: Ios.font; font-size: 26px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "SCORE"; color: #9DA9C1; font-family: Ios.font; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
        Text { text: AppState.shard-score; color: #E9DDFF; font-family: Ios.font; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "LEVEL"; color: #9DA9C1; font-family: Ios.font; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
        Text { text: AppState.shard-level; color: #E9DDFF; font-family: Ios.font; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "Solver predicted you"; color: #9DA9C1; font-family: Ios.font; font-size: 11px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
        Text { text: AppState.shard-solver; color: #C6FF3D; font-family: Ios.font; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
    }

    // Next piece preview (4x4 cells).
    Rectangle {
        x: root.width - 108px; y: 214px; width: 96px; height: 20px;
        Text { text: "NEXT"; color: #9DA9C1; font-family: Ios.font; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
    }
    Rectangle {
        x: root.width - 96px; y: 236px; width: 72px; height: 72px;
        background: #111725; border-width: 1px; border-color: #46516A; border-radius: 4px;
        for n[i] in AppState.next-cells: Rectangle {
            visible: n == 1;
            x: mod(i, 4) * 18px; y: floor(i / 4) * 18px; width: 18px; height: 18px;
            background: #C8AEFF; border-width: 1px; border-color: #F1E8FF;
        }
    }
    HorizontalLayout {
        x: root.width - 100px; y: 322px; width: 88px; height: 18px; spacing: 7px;
        Rectangle { width: 15px; height: 15px; background: transparent; border-width: 2px; border-color: #BB9CFF; }
        Text { text: "Landing"; color: #C8D0E0; font-family: Ios.font; font-size: 13px; }
    }

    // The full-width field accepts gestures, including the gutters beside the board.
    TouchArea {
        y: 200px; width: root.width; height: 480px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.applied = 0; root.applied-y = 0; root.axis = 0; }
            if e.kind == PointerEventKind.up {
                let dx = self.mouse-x - self.pressed-x;
                let dy = self.mouse-y - self.pressed-y;
                if root.axis == 0 && (abs(dx) > 10px || abs(dy) > 10px) {
                    root.axis = abs(dy) > abs(dx) * 1.15 ? 2 : 1;
                }
                if root.axis == 0 { AppState.shard-rotate(); }
                else if root.axis == 2 { let rows = floor(dy / root.cell); if rows > root.applied-y { AppState.shard-soft(rows - root.applied-y); root.applied-y = rows; } }
                else if root.axis == 1 {
                    let raw = dx / root.cell;
                    let steps = raw < 0 ? ceil(raw) : floor(raw);
                    if steps != root.applied { AppState.shard-move(steps - root.applied); root.applied = steps; }
                }
            }
        }
        moved => {
            if self.pressed {
                let dx = self.mouse-x - self.pressed-x;
                let dy = self.mouse-y - self.pressed-y;
                if root.axis == 0 && (abs(dx) > 10px || abs(dy) > 10px) {
                    root.axis = abs(dy) > abs(dx) * 1.15 ? 2 : 1;
                }
                if root.axis == 1 {
                    let raw = dx / root.cell;
                    let steps = raw < 0 ? ceil(raw) : floor(raw);
                    if steps != root.applied { AppState.shard-move(steps - root.applied); root.applied = steps; }
                }
                if root.axis == 2 {
                    let rows = floor(dy / root.cell);
                    if rows > root.applied-y { AppState.shard-soft(rows - root.applied-y); root.applied-y = rows; }
                }
            }
        }
    }

    HorizontalLayout {
        x: 12px; y: 700px; width: root.width - 24px; height: 64px; spacing: 8px;
        ShardControl { width: 78px; text: "Left"; activated => { AppState.shard-move(-1); } }
        ShardControl { width: 128px; text: "Rotate"; activated => { AppState.shard-rotate(); } }
        ShardControl { width: 78px; text: "Right"; activated => { AppState.shard-move(1); } }
        ShardControl { width: 148px; text: "Drop"; primary: true; activated => { AppState.shard-drop(); } }
    }
    Text {
        x: 12px; y: 777px; width: root.width - 24px; height: 18px;
        text: "Drag: move    Tap: rotate    Swipe down: soft drop";
        color: #A2ADC2; font-family: Ios.font; font-size: 14px; horizontal-alignment: center;
    }

    NavBar {
        y: 40px; width: root.width; title: "Shard Stack"; back-label: "Home"; right-label: "Done";
        right-enabled: AppState.touch-bits + AppState.camera-bits + AppState.game-bits >= AppState.target-bits;
        back => { AppState.back-home(); }
        right => { AppState.painter-done(); }
    }
}
