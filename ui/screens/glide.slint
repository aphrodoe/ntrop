import { Theme, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { AppState, Neon } from "../state.slint";
import { Meter } from "../widgets/meter.slint";

export component GlideScreen inherits Rectangle {
    background: Theme.palette-background;

    VerticalLayout {
        padding: Theme.spacing-xl;
        padding-top: Theme.spacing-xl * 2;
        spacing: Theme.spacing-md;
        Meter { vertical-stretch: 0; }
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.spacing-md;
            Button { text: "Home"; variant: ButtonVariant.ghost; clicked => { AppState.back-home(); } }
            Button {
                text: "Done";
                disabled: AppState.touch-bits + AppState.camera-bits + AppState.game-bits < AppState.target-bits;
                clicked => { AppState.painter-done(); }
            }
        }
        Text {
            text: AppState.glide-note;
            color: AppState.game-healthy ? Neon.game : Theme.palette-danger;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-label;
            horizontal-alignment: center;
            vertical-stretch: 0;
        }
        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                x: (parent.width - 480px) / 2;
                y: 0px;
                width: 480px;
                height: 480px;
                background: Neon.raised;
                clip: true;
                for p in AppState.pillars: Rectangle {
                    x: p.x;
                    y: 0px;
                    width: 56px;
                    height: 480px;
                    // flat pillar: two solid stripes with the gap between them
                    Rectangle { y: 0px; width: 100%; height: p.gap-y - 85px; background: Neon.line; border-color: Neon.game; border-width: 2px; }
                    Rectangle { y: p.gap-y + 85px; width: 100%; height: 480px - (p.gap-y + 85px); background: Neon.line; border-color: Neon.game; border-width: 2px; }
                }
                Rectangle { x: 120px - 18px; y: AppState.glider-y - 18px; width: 36px; height: 36px; border-radius: 18px; background: Neon.game.transparentize(0.65); }
                Rectangle { x: 120px - 10px; y: AppState.glider-y - 10px; width: 20px; height: 20px; border-radius: 10px; background: Neon.game; }
                // fire on press, not release, so a quick second tap is never swallowed
                TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down { AppState.glide-tap(self.mouse-x, self.mouse-y); }
                    }
                }
            }
        }
    }
}
