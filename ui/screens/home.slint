import { Theme } from "@ui/theme.slint";
import { AppState, Neon } from "../state.slint";

component GameCard inherits Rectangle {
    in property <string> title;
    in property <string> hook;
    in property <color> accent;
    callback clicked();
    height: 92px;
    border-radius: Theme.radius-md;
    background: Theme.palette-surface;
    border-width: 2px;
    border-color: ta.pressed ? root.accent : Neon.line;
    HorizontalLayout {
        padding: Theme.spacing-lg;
        spacing: Theme.spacing-md;
        Rectangle { width: 6px; background: root.accent; border-radius: 3px; }
        VerticalLayout {
            alignment: center;
            spacing: Theme.spacing-xs;
            Text {
                text: root.title;
                color: Theme.palette-foreground;
                font-family: Theme.font-primary;
                font-size: Theme.font-size-body;
                font-weight: Theme.font-weight-semibold;
            }
            Text {
                text: root.hook;
                color: root.accent;
                font-family: Theme.font-primary;
                font-size: Theme.font-size-label;
                overflow: elide;
            }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component WordToggle inherits Rectangle {
    in property <int> value;
    in property <int> option;
    callback picked();
    horizontal-stretch: 1;
    height: 48px;
    border-radius: 24px;
    background: root.value == root.option ? Theme.palette-primary : Neon.raised;
    Text {
        text: root.option + " words";
        color: root.value == root.option ? Theme.palette-background : Theme.palette-muted;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-body;
        font-weight: Theme.font-weight-semibold;
    }
    TouchArea { clicked => { root.picked(); } }
}

export component HomeScreen inherits VerticalLayout {
    property <int> words: 24;
    padding: Theme.spacing-xl;
    padding-top: Theme.spacing-xl * 2;
    spacing: Theme.spacing-md;

    Text {
        text: "Entropy Arcade";
        color: Theme.palette-primary;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-title;
        font-weight: Theme.font-weight-semibold;
        horizontal-alignment: center;
    }
    Text {
        text: "Can you trust one chip?";
        color: Theme.palette-muted;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-body;
        horizontal-alignment: center;
    }
    HorizontalLayout {
        spacing: Theme.spacing-sm;
        WordToggle { value: root.words; option: 12; picked => { root.words = 12; } }
        WordToggle { value: root.words; option: 24; picked => { root.words = 24; } }
    }
    GameCard { title: "Chaos Painter"; hook: "Scribble. Your hand is the noise."; accent: Neon.touch; clicked => { AppState.start-arcade(root.words, 0); } }
    GameCard { title: "Outguess the Machine"; hook: "Be less predictable than a bot."; accent: Neon.game; clicked => { AppState.start-arcade(root.words, 1); } }
    GameCard { title: "Static Hunt"; hook: "Blast static ghosts. Your misses are the dice."; accent: Neon.game; clicked => { AppState.start-arcade(root.words, 2); } }
    GameCard { title: "Dice Duel"; hook: "Roll real dice. No chip involved."; accent: Theme.palette-foreground; clicked => { AppState.start-dice(root.words); } }
    Rectangle { vertical-stretch: 1; }
}
