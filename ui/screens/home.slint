import { Theme } from "@ui/theme.slint";
import { Sheet } from "@ui/sheet.slint";
import { AppState, Ios } from "../state.slint";
import { GlossyIcon } from "../kit/glossy_icon.slint";
import { Segmented } from "../kit/segmented.slint";

// iPhone OS 1 homage: a 4-column icon grid on black and a 4-slot dock.
export component HomeScreen inherits Rectangle {
    property <int> words: seg.selected == 0 ? 12 : 24;
    property <bool> help: false;
    background: #000000;

    Rectangle { background: @radial-gradient(circle, #121212 0%, #060606 55%, #000000 100%); }

    Text {
        y: 48px; width: root.width; horizontal-alignment: center;
        text: "Entropy Arcade"; color: #B8B8B8;
        font-family: Ios.font; font-size: 15px; font-weight: 700;
    }
    seg := Segmented {
        x: (root.width - 260px) / 2; y: 74px; width: 260px;
        options: ["12 words", "24 words"];
        selected: 1;
    }

    GlossyIcon { x: 5px; y: 142px; icon: @image-url("../../resources/icons/spark.svg"); label: "Glider"; tint: #2A86DD; clicked => { AppState.start-arcade(root.words, 3); } }
    GlossyIcon { x: 125px; y: 142px; icon: @image-url("../../resources/icons/shard.svg"); label: "Shard"; tint: #138C86; clicked => { AppState.start-arcade(root.words, 4); } }
    GlossyIcon { x: 245px; y: 142px; icon: @image-url("../../resources/icons/info.svg"); label: "How it works"; tint: #6F7D91; clicked => { root.help = true; } }

    Text {
        y: 262px; width: root.width; horizontal-alignment: center;
        text: "Can you trust one chip?"; color: #8C8C8C;
        font-family: Ios.font; font-size: 16px;
    }

    dock := Rectangle {
        y: root.height - self.height; height: 116px;
        // metal mesh shelf with a solid label band, as on the 2007 dock
        Image { y: 0; width: parent.width; height: 90px; source: @image-url("../../resources/icons/dock-mesh.svg"); }
        Rectangle { y: 90px; height: 26px; background: @linear-gradient(180deg, #5E6064 0%, #75777B 30%, #86888C 100%); }
        Rectangle { y: 90px; height: 1px; background: #3A3C40; }
        GlossyIcon { x: 5px; y: 13px; icon: @image-url("../../resources/icons/paintbrush.svg"); label: "Painter"; tint: #E8771A; clicked => { AppState.start-arcade(root.words, 0); } }
        GlossyIcon { x: 125px; y: 13px; icon: @image-url("../../resources/icons/doors.svg"); label: "Outguess"; tint: #6A46D6; clicked => { AppState.start-arcade(root.words, 1); } }
        GlossyIcon { x: 245px; y: 13px; icon: @image-url("../../resources/icons/ghost.svg"); label: "Hunt"; tint: #2F9A45; clicked => { AppState.start-arcade(root.words, 2); } }
        GlossyIcon { x: 365px; y: 13px; icon: @image-url("../../resources/icons/die.svg"); label: "Dice"; tint: #C42A2A; clicked => { AppState.start-dice(root.words); } }
    }

    Sheet {
        width: parent.width;
        height: parent.height;
        open <=> root.help;
        Text { text: "How it works"; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-title; font-weight: Theme.font-weight-semibold; }
        for line in [
            "We mix your chaos with the chip's randomness: SHA-256(chip + you).",
            "Even if you play badly, it's never weaker than the chip.",
            "Credits are conservative estimates; stale input is rejected live.",
            "Outguess, Static Hunt, Glitch Glider and Shard Stack only pay for what the machine can't predict.",
            "Dice Duel uses only your dice, so you can verify it on a laptop."
        ]: Text { text: line; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-body; wrap: word-wrap; }
    }
}
