import { AppState, Ios } from "../state.slint";
import { GlossyButton } from "../kit/glossy_button.slint";
import { GlossyIcon } from "../kit/glossy_icon.slint";
import { Segmented } from "../kit/segmented.slint";
import { NavBar } from "../kit/nav_bar.slint";
import { Pinstripe } from "../kit/pinstripe.slint";
import { GroupedCell } from "../kit/grouped_cell.slint";

// iPhone OS 1 homage: a 4-column icon grid on black and a 4-slot dock.
export component HomeScreen inherits Rectangle {
    property <int> words: AppState.word-option == 0 ? 12 : 24;
    property <bool> help: false;
    background: #000000;

    Rectangle { background: @radial-gradient(circle, #121212 0%, #060606 55%, #000000 100%); }

    Text {
        y: 48px; width: root.width; horizontal-alignment: center;
        text: "Entropy Arcade"; color: #B8B8B8;
        font-family: Ios.font; font-size: 15px; font-weight: 700;
    }
    seg := Segmented {
        x: (root.width - 260px) / 2; y: 74px; width: 260px;
        options: ["12 words", "24 words"];
        selected <=> AppState.word-option;
    }

    GlossyIcon { x: 12px; y: 138px; icon: @image-url("../../resources/icons/shard.svg"); label: "Shard"; tint: #138C86; clicked => { AppState.start-arcade(root.words, 4, 1); } }
    GlossyIcon { x: 126px; y: 138px; icon: @image-url("../../resources/icons/info.svg"); label: "How it works"; tint: #6F7D91; clicked => { root.help = true; } }

    Text {
        y: 268px; width: root.width; horizontal-alignment: center;
        text: "Can you trust one chip?"; color: #8C8C8C;
        font-family: Ios.font; font-size: 16px;
    }

    Rectangle {
        x: 24px; y: 340px; width: root.width - 48px; height: 176px;
        border-radius: 14px; background: #17151F; border-width: 1px; border-color: #393144;
        Text {
            x: 16px; y: 14px; width: parent.width - 32px; height: 28px;
            text: "Outguess"; color: #FFFFFF; font-family: Ios.font; font-size: 22px; font-weight: 700;
        }
        Segmented {
            x: 16px; y: 58px; width: parent.width - 144px;
            options: ["1 player", "2 players"];
            selected <=> AppState.outguess-player-option;
        }
        GlossyButton {
            x: parent.width - 116px; y: 51px; width: 100px;
            text: "Play"; primary: true;
            clicked => { AppState.start-arcade(root.words, 1, AppState.outguess-player-option + 1); }
        }
        Text {
            x: 16px; y: 122px; width: parent.width - 32px; height: 38px;
            text: AppState.outguess-player-option == 0 ? "Beat the machine at its own guessing game."
                : "Face-to-face Duel. One device. First to 10.";
            color: #BDB5CC; font-family: Ios.font; font-size: 16px; wrap: word-wrap;
        }
    }

    dock := Rectangle {
        y: root.height - self.height; height: 136px;
        // metal mesh shelf with a solid label band, as on the 2007 dock
        Image { y: 0; width: parent.width; height: 112px; source: @image-url("../../resources/icons/dock-mesh.svg"); }
        Rectangle { y: 112px; height: 24px; background: @linear-gradient(180deg, #5E6064 0%, #75777B 30%, #86888C 100%); }
        Rectangle { y: 112px; height: 1px; background: #3A3C40; }
        GlossyIcon { x: 12px; y: 14px; label-y: 101px; icon: @image-url("../../resources/icons/paintbrush.svg"); label: "Painter"; tint: #E8771A; clicked => { AppState.start-arcade(root.words, 0, 1); } }
        GlossyIcon { x: 126px; y: 14px; label-y: 101px; icon: @image-url("../../resources/icons/doors.svg"); label: "Outguess"; tint: #6A46D6; clicked => { AppState.start-arcade(root.words, 1, AppState.outguess-player-option + 1); } }
        GlossyIcon { x: 240px; y: 14px; label-y: 101px; icon: @image-url("../../resources/icons/ghost.svg"); label: "Hunt"; tint: #2F9A45; clicked => { AppState.start-arcade(root.words, 2, 1); } }
        GlossyIcon { x: 354px; y: 14px; label-y: 101px; icon: @image-url("../../resources/icons/die.svg"); label: "Dice"; tint: #C42A2A; clicked => { AppState.start-dice(root.words); } }
    }

    if root.help: Pinstripe {
        NavBar { y: 40px; width: parent.width; title: "How it works"; back-label: "Home"; back => { root.help = false; } }
        VerticalLayout {
            y: 104px; height: parent.height - 104px;
            padding: 18px; padding-top: 22px;
            property <[string]> lines: [
                "We mix your chaos with the chip's randomness: SHA-256(chip + you).",
                "Even if you play badly, it's never weaker than the chip.",
                "Credits are conservative estimates; stale input is rejected live.",
                "Outguess, Static Hunt and Shard Stack only pay for what the machine can't predict.",
                "Dice Duel uses only your dice, so you can verify it on a laptop."
            ];
            for line[i] in self.lines: GroupedCell { first: i == 0; last: i == 4; wrap: true; label: line; }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
