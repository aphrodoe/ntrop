import { Theme, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Sheet } from "@ui/sheet.slint";
import { AppState, Neon } from "../state.slint";

component GameCard inherits Rectangle {
    in property <string> title;
    in property <string> hook;
    in property <color> accent;
    callback clicked();
    min-height: 96px;
    border-radius: Theme.radius-md;
    background: Theme.palette-surface;
    border-width: 2px;
    border-color: ta.pressed ? root.accent : Neon.line;
    HorizontalLayout {
        padding: Theme.spacing-md;
        spacing: Theme.spacing-md;
        VerticalLayout {
            alignment: center;
            spacing: Theme.spacing-xs;
            Text {
                text: root.title;
                color: Theme.palette-foreground;
                font-family: Theme.font-primary;
                font-size: Theme.font-size-body;
                font-weight: Theme.font-weight-semibold;
            }
            Text {
                text: root.hook;
                color: root.accent;
                font-family: Theme.font-primary;
                font-size: Theme.font-size-label;
                wrap: word-wrap;
            }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component WordToggle inherits Rectangle {
    in property <int> value;
    in property <int> option;
    callback picked();
    horizontal-stretch: 1;
    height: 48px;
    border-radius: 24px;
    background: root.value == root.option ? Theme.palette-primary : Neon.raised;
    Text {
        text: root.option + " words";
        color: root.value == root.option ? Theme.palette-background : Theme.palette-muted;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-body;
        font-weight: Theme.font-weight-semibold;
    }
    TouchArea { clicked => { root.picked(); } }
}

export component HomeScreen inherits Rectangle {
    property <int> words: 24;
    property <bool> help: false;
    VerticalLayout {
    width: parent.width;
    height: parent.height;
    padding: Theme.spacing-xl;
    padding-top: Theme.spacing-xl * 2;
    spacing: Theme.spacing-md;

    Text {
        text: "Entropy Arcade";
        color: Theme.palette-primary;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-title;
        font-weight: Theme.font-weight-semibold;
        horizontal-alignment: center;
    }
    Text {
        text: "Can you trust one chip?";
        color: Theme.palette-muted;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-body;
        horizontal-alignment: center;
    }
    HorizontalLayout {
        spacing: Theme.spacing-sm;
        WordToggle { value: root.words; option: 12; picked => { root.words = 12; } }
        WordToggle { value: root.words; option: 24; picked => { root.words = 24; } }
    }
    GridLayout {
        spacing: Theme.spacing-sm;
        Row {
            GameCard { title: "Chaos Painter"; hook: "Scribble. Your hand is the noise."; accent: Neon.touch; clicked => { AppState.start-arcade(root.words, 0); } }
            GameCard { title: "Outguess"; hook: "Be less predictable than a bot."; accent: Neon.game; clicked => { AppState.start-arcade(root.words, 1); } }
        }
        Row {
            GameCard { title: "Static Hunt"; hook: "Blast ghosts. Misses are dice."; accent: Neon.game; clicked => { AppState.start-arcade(root.words, 2); } }
            GameCard { title: "Glitch Glider"; hook: "Tap to fly. Your timing wobble is the noise."; accent: Neon.game; clicked => { AppState.start-arcade(root.words, 3); } }
        }
        Row {
            GameCard { title: "Shard Stack"; hook: "Stack shards. Surprise the solver."; accent: Neon.game; clicked => { AppState.start-arcade(root.words, 4); } }
            GameCard { title: "Dice Duel"; hook: "Real dice. No chip."; accent: Theme.palette-foreground; clicked => { AppState.start-dice(root.words); } }
        }
    }
    Rectangle { vertical-stretch: 1; }
    Button { text: "How it works"; variant: ButtonVariant.ghost; clicked => { root.help = true; } }
    }
    Sheet {
        width: parent.width;
        height: parent.height;
        open <=> root.help;
        Text { text: "How it works"; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-title; font-weight: Theme.font-weight-semibold; }
        for line in [
            "We mix your chaos with the chip's randomness: SHA-256(chip + you).",
            "Even if you play badly, it's never weaker than the chip.",
            "Credits are conservative estimates; stale input is rejected live.",
            "Outguess, Static Hunt, Glitch Glider and Shard Stack only pay for what the machine can't predict.",
            "Dice Duel uses only your dice, so you can verify it on a laptop."
        ]: Text { text: line; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: Theme.font-size-body; wrap: word-wrap; }
    }
}
