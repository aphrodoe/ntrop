import { Ios } from "../state.slint";

export component NavBar inherits Rectangle {
    in property <string> title;
    in property <string> back-label: "Back";
    in property <bool> show-back: true;
    in property <string> right-label; // a blue "Done"-style bar button when set
    in property <bool> right-enabled: true;
    callback back();
    callback right();
    height: 64px;
    background: @linear-gradient(180deg, Ios.bar-top 0%, #8FA1BA 50%, #8196B1 50%, Ios.bar-bottom 100%);
    TouchArea { } // the bar never passes taps to a playfield underneath
    Rectangle { y: 0; height: 1px; background: #D3DAE3; }
    Rectangle { y: parent.height - 1px; height: 1px; background: Ios.bar-line; }

    // engraved title: a dark copy 1 px above the white one
    for c[i] in [#00000066, #FFFFFF]: Text {
        y: (root.height - self.height) / 2 + i * 1px - 1px;
        width: root.width; horizontal-alignment: center;
        text: root.title; color: c;
        font-family: Ios.font; font-size: 22px; font-weight: 700;
    }

    // arrow-shaped back button: one nine-slice image (fixed tip and rounded end, stretched middle)
    if root.show-back: Rectangle {
        x: 8px; y: 10px; height: 44px;
        width: lbl.preferred-width + 34px;
        Image { width: parent.width; height: 44px; source: @image-url("../../resources/icons/back-button.svg", nine-slice(6 8 6 20)); }
        Text { x: 22px; y: (parent.height - self.height) / 2 - 1px; text: root.back-label; color: #00000066; font-family: Ios.font; font-size: 16px; font-weight: 700; }
        lbl := Text { x: 22px; y: (parent.height - self.height) / 2; text: root.back-label; color: #FFFFFF; font-family: Ios.font; font-size: 16px; font-weight: 700; }
        if back-ta.pressed: Rectangle { x: 14px; width: parent.width - 18px; y: 3px; height: 38px; border-radius: 5px; background: #00000040; }
        back-ta := TouchArea { clicked => { root.back(); } }
    }

    if root.right-label != "": Rectangle {
        x: root.width - self.width - 8px; y: 10px; height: 44px;
        width: rl.preferred-width + 28px;
        opacity: root.right-enabled ? 1 : 0.5;
        Image { width: parent.width; height: 44px; source: @image-url("../../resources/icons/bar-button-done.svg", nine-slice(8)); }
        Text { x: 14px; y: (parent.height - self.height) / 2 - 1px; text: root.right-label; color: #00000066; font-family: Ios.font; font-size: 16px; font-weight: 700; }
        rl := Text { x: 14px; y: (parent.height - self.height) / 2; text: root.right-label; color: #FFFFFF; font-family: Ios.font; font-size: 16px; font-weight: 700; }
        if right-ta.pressed: Rectangle { x: 2px; y: 2px; width: parent.width - 4px; height: 40px; border-radius: 6px; background: #00000040; }
        right-ta := TouchArea { enabled: root.right-enabled; clicked => { root.right(); } }
    }
}
