import { Ios } from "../state.slint";

// Dimmed backdrop with a dark translucent sheet of glossy pill buttons at the bottom.
export component ActionSheet inherits Rectangle {
    in property <[string]> buttons;
    callback chosen(int);
    background: #00000080;
    TouchArea { } // swallow taps behind the sheet
    Rectangle {
        y: root.height - self.height;
        height: lay.preferred-height;
        background: @linear-gradient(180deg, #4A5568E6 0%, #1C2230F2 100%);
        Rectangle { y: 0; height: 1px; background: #A8B4C8; }
        lay := VerticalLayout {
            padding: 20px;
            padding-bottom: 28px;
            spacing: 12px;
            for b[i] in root.buttons: Rectangle {
                height: 58px;
                Image {
                    width: parent.width; height: 58px;
                    source: ta.pressed ? @image-url("../../resources/icons/sheet-button-on.svg", nine-slice(12)) : @image-url("../../resources/icons/sheet-button.svg", nine-slice(12));
                }
                Text { text: b; color: ta.pressed ? #FFFFFF : #1A1A1A; font-family: Ios.font; font-size: 21px; font-weight: 700; }
                ta := TouchArea { clicked => { root.chosen(i); } }
            }
        }
    }
}
