import { Ios } from "../state.slint";
import { GlossyButton } from "glossy_button.slint";

// Dimmed backdrop with a dark translucent sheet of glossy pill buttons at the bottom.
export component ActionSheet inherits Rectangle {
    in property <string> title;
    in property <[string]> buttons;
    callback chosen(int);
    background: #00000080;
    TouchArea { } // swallow taps behind the sheet
    Rectangle {
        y: root.height - self.height;
        height: lay.preferred-height;
        background: @linear-gradient(180deg, #4A5568E6 0%, #1C2230F2 100%);
        Rectangle { y: 0; height: 1px; background: #A8B4C8; }
        lay := VerticalLayout {
            padding: 20px;
            padding-bottom: 28px;
            spacing: 12px;
            if root.title != "": Text { text: root.title; color: #FFFFFF; font-family: Ios.font; font-size: 19px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
            for b[i] in root.buttons: GlossyButton { text: b; clicked => { root.chosen(i); } }
        }
    }
}
