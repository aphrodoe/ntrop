import { Theme, UISize, Images, ControlSize } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { AppState, Screen, TrailDot, Pillar } from "state.slint";
import { HomeScreen } from "screens/home.slint";
import { PainterScreen } from "screens/painter.slint";
import { OutguessScreen } from "screens/outguess.slint";
import { HuntScreen } from "screens/hunt.slint";
import { GlideScreen } from "screens/glide.slint";
import { SummaryScreen } from "screens/summary.slint";
import { WordsScreen } from "screens/words.slint";
import { SeedQrScreen } from "screens/seedqr.slint";
import { QuizScreen } from "screens/quiz.slint";
import { DoneScreen } from "screens/done.slint";
import { DiceScreen } from "screens/dice.slint";
import { ErrorScreen } from "screens/error.slint";

export { AppState, Screen, TrailDot, Pillar, Theme, Images, ControlSize }
export component AppWindow inherits Window {
    title: "Entropy Arcade";
    preferred-width: UISize.screen-width;
    preferred-height: UISize.screen-height;
    background: Theme.palette-background;

    if AppState.screen == Screen.home: HomeScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.painter: PainterScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.outguess: OutguessScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.hunt: HuntScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.glide: GlideScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.summary: SummaryScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.error: ErrorScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.words: WordsScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.seedqr: SeedQrScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.quiz: QuizScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.done: DoneScreen { width: parent.width; height: parent.height; }
    if AppState.screen == Screen.dice: DiceScreen { width: parent.width; height: parent.height; }
}
