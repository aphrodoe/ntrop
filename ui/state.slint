// SPDX-License-Identifier: MIT

import "../resources/fonts/Arimo-Regular.ttf";
import "../resources/fonts/Arimo-Bold.ttf";

export enum Screen { home, painter, outguess, duel, duelowner, hunt, shard, summary, words, seedqr, quiz, done, dice, error }

// Colours with no theme token: source identities plus the ink-palette extras.
export global Neon {
    out property <color> touch: #00E5FF;
    out property <color> camera: #FF2BD6;
    out property <color> game: #8B5CFF;
    out property <color> raised: #1E1B2C;
    out property <color> line: #2C2840;
    out property <color> warning: #FFB020;
}

// iPhone OS 1 homage chrome (spec "Visual direction (superseded 2026-10-31)").
export global Ios {
    out property <string> font: "Arimo";
    out property <color> bar-top: #B0BCCD;
    out property <color> bar-bottom: #6D84A2;
    out property <color> bar-line: #2D3642;
    out property <color> stripe-bg: #C5CCD4;
    out property <color> stripe: #CBD2D8;
    out property <color> separator: #ABABAB;
    out property <color> detail: #385487;
    out property <color> label: #000000;
    out property <color> blue-top: #8EB4F5;
    out property <color> blue-mid: #4A84E8;
    out property <color> blue-bottom: #1D5ED6;
}

export struct TrailDot { x: length, y: length, age: float }

export global AppState {
    in-out property <Screen> screen: Screen.home;
    in-out property <int> word-option: 1;
    in-out property <int> outguess-player-option: 0;
    in property <int> touch-bits;
    in property <int> camera-bits;
    in property <int> target-bits: 128;
    in property <int> game-bits;
    in property <bool> game-healthy: true;
    in property <bool> touch-healthy: true;
    in property <bool> camera-healthy: true;
    in property <bool> camera-on: false;
    in property <image> camera-preview;
    in property <string> camera-note;
    in property <[TrailDot]> trail;
    in property <string> error-text;

    callback start-arcade(int /* 12 | 24 */, int /* game: 0 painter, 1 outguess, 2 hunt, 4 shard (3 retired) */, int /* players: 1 | 2 */);
    callback start-dice(int);
    // Dice Duel: rolls-text is masked ("•••• 1 5"), never the full rolls
    in property <int> roll-count;
    in property <int> rolls-needed: 50;
    in property <float> dice-bits;
    in property <string> rolls-text;
    in property <string> dice-note;
    in property <bool> dice-run;
    in property <int> dice-words: 12;
    callback roll(int);
    callback undo-roll();
    callback dice-done();
    callback pick-door(int, length, length);
    in property <int> last-guess: -1;
    in property <bool> last-hit;
    in property <string> last-credit;
    in property <int> read-pct;
    in property <int> last-pick: -1;
    in property <int> outguess-round;
    // Duel choices stay in Rust until both players lock. These doors are revealed only.
    callback duel-pick(int /* player */, int /* door */, length, length);
    callback duel-next-match();
    callback duel-owner-ready();
    in property <int> duel-round: 1;
    in property <int> duel-moves;
    in property <int> duel-hider;
    in property <int> duel-p1-score;
    in property <int> duel-p2-score;
    in property <bool> duel-p1-locked;
    in property <bool> duel-p2-locked;
    in property <bool> duel-p1-healthy: true;
    in property <bool> duel-p2-healthy: true;
    in property <int> duel-countdown;
    in property <bool> duel-revealed;
    in property <int> duel-p1-door: -1;
    in property <int> duel-p2-door: -1;
    in property <bool> duel-hit;
    in property <int> duel-winner: -1;
    in property <string> duel-note;
    callback touch(length, length);
    // Static Hunt: 240x288 frame shown at 2x
    in property <image> hunt-frame;
    in property <string> hunt-pop;
    in property <string> hunt-note;
    callback hunt-press(length, length);
    callback hunt-move(length, length);
    callback hunt-release(length, length);
    // Shard Stack: 8x16 board, row-major, 1 = filled; ghost = the waiting piece at the top
    in property <[int]> shard-cells;
    in property <[int]> ghost-cells;
    in property <[int]> landing-cells;
    in property <string> shard-note;
    in property <int> shard-placements;
    in property <int> shard-lines;
    callback shard-move(int);
    callback shard-rotate();
    callback shard-drop();
    callback toggle-camera();
    callback painter-done();
    callback generate();
    callback back-home();

    // Words (6 per page)
    in property <[string]> page-words;
    in property <int> page;
    in property <int> page-count;
    in property <int> first-index;
    callback next-page();
    callback prev-page();
    // SeedQR
    in property <image> qr;
    callback start-quiz();
    // Quiz
    in property <int> quiz-step;
    in property <int> quiz-position;
    in property <[string]> quiz-choices;
    callback answer(int);
    // Done
    in property <string> fingerprint;
    in property <string> art;
    callback finish();
}
