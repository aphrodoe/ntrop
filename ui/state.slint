// SPDX-License-Identifier: MIT

export enum Screen { home, painter, outguess, hunt, summary, words, seedqr, quiz, done, dice, error }

// Colours with no theme token: source identities plus the ink-palette extras.
export global Neon {
    out property <color> touch: #00E5FF;
    out property <color> camera: #FF2BD6;
    out property <color> game: #8B5CFF;
    out property <color> raised: #1E1B2C;
    out property <color> line: #2C2840;
    out property <color> warning: #FFB020;
}

export struct TrailDot { x: length, y: length, age: float }

export global AppState {
    in-out property <Screen> screen: Screen.home;
    in property <int> touch-bits;
    in property <int> camera-bits;
    in property <int> target-bits: 128;
    in property <int> game-bits;
    in property <bool> game-healthy: true;
    in property <bool> touch-healthy: true;
    in property <bool> camera-healthy: true;
    in property <bool> camera-on: false;
    in property <[TrailDot]> trail;
    in property <string> error-text;

    callback start-arcade(int /* 12 | 24 */, int /* game: 0 painter, 1 outguess, 2 hunt */);
    callback start-dice(int);
    callback pick-door(int, length, length);
    in property <int> last-guess: -1;
    in property <bool> last-hit;
    in property <string> last-credit;
    in property <int> read-pct;
    callback touch(length, length);
    // Static Hunt: 240x320 frame shown at 2x
    in property <image> hunt-frame;
    in property <string> hunt-pop;
    callback hunt-press(length, length);
    callback hunt-move(length, length);
    callback hunt-release(length, length);
    callback toggle-camera();
    callback painter-done();
    callback generate();
    callback back-home();

    // Words (6 per page)
    in property <[string]> page-words;
    in property <int> page;
    in property <int> page-count;
    in property <int> first-index;
    callback next-page();
    callback prev-page();
    // SeedQR
    in property <image> qr;
    callback start-quiz();
    // Quiz
    in property <int> quiz-step;
    in property <int> quiz-position;
    in property <[string]> quiz-choices;
    callback answer(int);
    // Done
    in property <string> fingerprint;
    in property <string> art;
    callback finish();
}
