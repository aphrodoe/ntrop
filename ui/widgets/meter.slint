import { Theme } from "@ui/theme.slint";
import { AppState } from "../state.slint";

export component Meter inherits VerticalLayout {
    spacing: Theme.spacing-sm;
    property <int> total: min(AppState.touch-bits + AppState.camera-bits, AppState.target-bits);

    // Segmented bar: touch (red while unhealthy) then camera.
    Rectangle {
        height: 12px;
        border-radius: 6px;
        background: Theme.palette-border;
        clip: true;
        Rectangle {
            x: 0px;
            width: parent.width * min(AppState.touch-bits, AppState.target-bits) / max(AppState.target-bits, 1);
            background: AppState.touch-healthy ? (root.total >= AppState.target-bits ? #4ade80 : Theme.palette-primary) : Theme.palette-danger;
        }
        Rectangle {
            x: parent.width * min(AppState.touch-bits, AppState.target-bits) / max(AppState.target-bits, 1);
            width: parent.width * min(AppState.camera-bits, AppState.target-bits - min(AppState.touch-bits, AppState.target-bits)) / max(AppState.target-bits, 1);
            background: AppState.camera-healthy ? Theme.palette-secondary : Theme.palette-danger;
        }
    }
    Text {
        text: root.total + " / " + AppState.target-bits + " bits (conservative estimate)";
        color: Theme.palette-muted;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-label;
        horizontal-alignment: center;
    }
    Text {
        visible: !AppState.touch-healthy || (AppState.camera-on && !AppState.camera-healthy);
        height: self.visible ? self.preferred-height : 0px;
        text: !AppState.touch-healthy ? "Touch looks repetitive: vary your strokes" : "Camera source unhealthy";
        color: Theme.palette-danger;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-label;
        horizontal-alignment: center;
    }
}
